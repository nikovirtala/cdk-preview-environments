{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(pnpm -c exec \"node --print process.env.PATH\")"
  },
  "tasks": {
    "biome": {
      "name": "biome",
      "description": "Runs Biome against the codebase",
      "steps": [
        {
          "execArgs": [
            "biome",
            "check",
            "--no-errors-on-unmatched",
            "--write"
          ],
          "receiveArgs": true
        }
      ]
    },
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bundle": {
      "name": "bundle",
      "description": "Prepare assets"
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile"
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "tsx --tsconfig test/tsconfig.json .projenrc.ts"
        },
        {
          "spawn": "install:homebrew"
        }
      ]
    },
    "deploy": {
      "name": "deploy",
      "description": "Deploys your CDK app to the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "destroy": {
      "name": "destroy",
      "description": "Destroys your cdk app in the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "destroy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "diff": {
      "name": "diff",
      "description": "Diffs the currently deployed app against your code",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "diff"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "homebrew:bundle": {
      "name": "homebrew:bundle",
      "steps": [
        {
          "exec": "command -v brew >/dev/null 2>&1 || eval \"$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null || /opt/homebrew/bin/brew shellenv 2>/dev/null)\" && brew bundle"
        }
      ],
      "shell": [
        "bash",
        "-c"
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "pnpm i --no-frozen-lockfile"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "pnpm i --frozen-lockfile"
        }
      ]
    },
    "install:homebrew": {
      "name": "install:homebrew",
      "steps": [
        {
          "exec": "command -v brew >/dev/null 2>&1 || { NONINTERACTIVE=1 /bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\" && eval \"$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null || /opt/homebrew/bin/brew shellenv 2>/dev/null)\"; }"
        },
        {
          "spawn": "homebrew:bundle"
        }
      ],
      "shell": [
        "bash",
        "-c"
      ]
    },
    "mise:trust": {
      "name": "mise:trust",
      "steps": [
        {
          "exec": "mise trust"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "synth:silent"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "synth": {
      "name": "synth",
      "description": "Synthesizes your cdk app into cdk.out",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth"
          ]
        }
      ]
    },
    "synth:silent": {
      "name": "synth:silent",
      "description": "Synthesizes your cdk app into cdk.out and suppresses the template in stdout (part of \"yarn build\")",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth",
            "-q"
          ]
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "spawn": "biome"
        },
        {
          "exec": "vitest run",
          "receiveArgs": true
        }
      ]
    },
    "test:update": {
      "name": "test:update",
      "steps": [
        {
          "exec": "vitest --update",
          "receiveArgs": true
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "steps": [
        {
          "exec": "vitest watch",
          "receiveArgs": true
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "pnpm",
            "dlx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@nikovirtala/projen-constructs,esbuild,projen,tsx"
          ]
        },
        {
          "exec": "pnpm i --no-frozen-lockfile"
        },
        {
          "execArgs": [
            "pnpm",
            "update",
            "@biomejs/biome",
            "@nikovirtala/projen-constructs",
            "@types/node",
            "aws-cdk",
            "esbuild",
            "projen",
            "tsx",
            "typescript",
            "vitest",
            "@vitest/coverage-v8",
            "@aws-cdk-containers/ecs-service-extensions",
            "aws-cdk-lib",
            "constructs"
          ]
        },
        {
          "exec": "pnpm exec projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watches changes in your source code and rebuilds and deploys to the current account",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy",
            "--hotswap"
          ]
        },
        {
          "execArgs": [
            "cdk",
            "watch"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
